{
  "name": "SemanticModel",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Market Prices",
        "columns": [
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State",
            "summarizeBy": "none"
          },
          {
            "name": "District",
            "dataType": "string",
            "sourceColumn": "District",
            "summarizeBy": "none"
          },
          {
            "name": "Market",
            "dataType": "string",
            "sourceColumn": "Market",
            "summarizeBy": "none"
          },
          {
            "name": "Commodity",
            "dataType": "string",
            "sourceColumn": "Commodity",
            "summarizeBy": "none"
          },
          {
            "name": "Records",
            "dataType": "int64",
            "sourceColumn": "Records",
            "summarizeBy": "sum"
          },
          {
            "name": "Average Price",
            "dataType": "double",
            "sourceColumn": "'Average Price'",
            "summarizeBy": "none"
          },
          {
            "name": "Minimum Price",
            "dataType": "double",
            "sourceColumn": "'Minimum Price'",
            "summarizeBy": "none"
          },
          {
            "name": "Maximum Price",
            "dataType": "double",
            "sourceColumn": "'Maximum Price'",
            "summarizeBy": "none"
          },
          {
            "name": "Price Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'Price Key'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Market Prices",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"New_Query_2026_11_21_18_14_03.csv\"), [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state_name] <> null and [state_name] <> \"\"),",
                "    ReplacedNulls = Table.ReplaceValue(RemovedBlank, \"null\", \"Unknown\", Replacer.ReplaceValue, {\"cmdt_name\"}),",
                "    ChangedType = Table.TransformColumnTypes(ReplacedNulls, {{\"state_name\", type text}, {\"district_name\", type text}, {\"market_name\", type text}, {\"cmdt_name\", type text}, {\"total_records\", Int64.Type}, {\"average_price\", type number}, {\"minimum_price\", type number}, {\"maximum_price\", type number}}),",
                "    RenamedColumns = Table.RenameColumns(ChangedType, {{\"state_name\", \"State\"}, {\"district_name\", \"District\"}, {\"market_name\", \"Market\"}, {\"cmdt_name\", \"Commodity\"}, {\"total_records\", \"Records\"}, {\"average_price\", \"Average Price\"}, {\"minimum_price\", \"Minimum Price\"}, {\"maximum_price\", \"Maximum Price\"}}),",
                "    AddedKey = Table.AddColumn(RenamedColumns, \"Price Key\", each Text.Combine({Text.Lower([State]), \"|\", Text.Lower([District]), \"|\", Text.Lower([Market]), \"|\", Text.Lower([Commodity])}), type text)",
                "in",
                "    AddedKey"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Mandi Records",
            "description": "Total number of price records captured across mandis",
            "expression": "SUM('Market Prices'[Records])",
            "formatString": "#,0"
          },
          {
            "name": "Avg Market Price",
            "description": "Average traded price across markets",
            "expression": "AVERAGE('Market Prices'[Average Price])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Min Market Price",
            "description": "Lowest minimum price across markets",
            "expression": "MIN('Market Prices'[Minimum Price])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Max Market Price",
            "description": "Highest maximum price across markets",
            "expression": "MAX('Market Prices'[Maximum Price])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Markets Count",
            "description": "Number of distinct mandi markets reporting",
            "expression": "DISTINCTCOUNT('Market Prices'[Market])",
            "formatString": "#,0"
          },
          {
            "name": "Commodities Count",
            "description": "Number of distinct commodities traded",
            "expression": "DISTINCTCOUNT('Market Prices'[Commodity])",
            "formatString": "#,0"
          },
          {
            "name": "States Count",
            "description": "Number of states with reporting markets",
            "expression": "DISTINCTCOUNT('Market Prices'[State])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Latest Prices",
        "columns": [
          {
            "name": "State",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "State",
            "summarizeBy": "none"
          },
          {
            "name": "District",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "District",
            "summarizeBy": "none"
          },
          {
            "name": "Market",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Market",
            "summarizeBy": "none"
          },
          {
            "name": "Commodity",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Commodity",
            "summarizeBy": "none"
          },
          {
            "name": "Commodity Group",
            "dataType": "string",
            "sourceColumn": "'Commodity Group'",
            "summarizeBy": "none"
          },
          {
            "name": "Latest Price",
            "dataType": "double",
            "sourceColumn": "'Latest Price'",
            "summarizeBy": "none"
          },
          {
            "name": "Trend",
            "dataType": "string",
            "sourceColumn": "Trend",
            "summarizeBy": "none"
          },
          {
            "name": "Cumulative Arrivals",
            "dataType": "double",
            "sourceColumn": "'Cumulative Arrivals'",
            "summarizeBy": "sum"
          },
          {
            "name": "MSP Price",
            "dataType": "double",
            "sourceColumn": "'MSP Price'",
            "summarizeBy": "none"
          },
          {
            "name": "Price 5 Days Ago",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Price 5 Days Ago'",
            "summarizeBy": "none"
          },
          {
            "name": "Price 1 Week Ago",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Price 1 Week Ago'",
            "summarizeBy": "none"
          },
          {
            "name": "Price 1 Month Ago",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Price 1 Month Ago'",
            "summarizeBy": "none"
          },
          {
            "name": "Price 1 Year Ago",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Price 1 Year Ago'",
            "summarizeBy": "none"
          },
          {
            "name": "Price 2 Years Ago",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Price 2 Years Ago'",
            "summarizeBy": "none"
          },
          {
            "name": "Price 3 Years Ago",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Price 3 Years Ago'",
            "summarizeBy": "none"
          },
          {
            "name": "Reported Date",
            "dataType": "dateTime",
            "sourceColumn": "'Reported Date'",
            "formatString": "dd MMM yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Deviation %",
            "dataType": "double",
            "sourceColumn": "'Deviation %'",
            "summarizeBy": "none"
          },
          {
            "name": "Deviation from MSP",
            "dataType": "double",
            "sourceColumn": "'Deviation from MSP'",
            "summarizeBy": "none"
          },
          {
            "name": "Commodity Missing",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'Commodity Missing'",
            "summarizeBy": "none"
          },
          {
            "name": "Source",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Source",
            "summarizeBy": "none"
          },
          {
            "name": "Loaded At",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'Loaded At'",
            "summarizeBy": "none"
          },
          {
            "name": "Price Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'Price Key'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Latest Prices",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"Latest Market Prices.csv\"), [Delimiter=\",\", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state_name] <> null and [state_name] <> \"\"),",
                "    ReplacedNulls = Table.ReplaceValue(RemovedBlank, \"null\", null, Replacer.ReplaceValue, {\"one_yr_ago\", \"two_yr_ago\", \"three_yr_ago\", \"one_week_ago\", \"one_month_ago\", \"msp_price\", \"deviation_percent\", \"deviation_from_msp\", \"commodity_missing\"}),",
                "    ReplacedText = Table.ReplaceValue(ReplacedNulls, \"null\", \"Unknown\", Replacer.ReplaceValue, {\"trend\", \"cmdt_name\"}),",
                "    ChangedType = Table.TransformColumnTypes(ReplacedText, {{\"as_on\", type number}, {\"state_name\", type text}, {\"trend\", type text}, {\"cumm_arr\", type number}, {\"cmdt_name\", type text}, {\"msp_price\", type number}, {\"one_yr_ago\", type number}, {\"two_yr_ago\", type number}, {\"market_name\", type text}, {\"one_week_ago\", type number}, {\"three_yr_ago\", type number}, {\"cmdt_grp_name\", type text}, {\"district_name\", type text}, {\"last_five_day\", type number}, {\"one_month_ago\", type number}, {\"reported_date\", type date}, {\"deviation_percent\", type number}, {\"deviation_from_msp\", type number}, {\"commodity_missing\", type text}, {\"bronze_source\", type text}, {\"bronze_loaded_at\", type text}}),",
                "    RenamedColumns = Table.RenameColumns(ChangedType, {{\"as_on\", \"Latest Price\"}, {\"trend\", \"Trend\"}, {\"cumm_arr\", \"Cumulative Arrivals\"}, {\"cmdt_name\", \"Commodity\"}, {\"msp_price\", \"MSP Price\"}, {\"one_yr_ago\", \"Price 1 Year Ago\"}, {\"state_name\", \"State\"}, {\"two_yr_ago\", \"Price 2 Years Ago\"}, {\"market_name\", \"Market\"}, {\"one_week_ago\", \"Price 1 Week Ago\"}, {\"three_yr_ago\", \"Price 3 Years Ago\"}, {\"cmdt_grp_name\", \"Commodity Group\"}, {\"district_name\", \"District\"}, {\"last_five_day\", \"Price 5 Days Ago\"}, {\"one_month_ago\", \"Price 1 Month Ago\"}, {\"reported_date\", \"Reported Date\"}, {\"deviation_percent\", \"Deviation %\"}, {\"deviation_from_msp\", \"Deviation from MSP\"}, {\"commodity_missing\", \"Commodity Missing\"}, {\"bronze_source\", \"Source\"}, {\"bronze_loaded_at\", \"Loaded At\"}}),",
                "    AddedKey = Table.AddColumn(RenamedColumns, \"Price Key\", each Text.Combine({Text.Lower([State]), \"|\", Text.Lower([District]), \"|\", Text.Lower([Market]), \"|\", Text.Lower([Commodity])}), type text)",
                "in",
                "    AddedKey"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Markets Reporting",
            "description": "Number of market-commodity price rows reported",
            "expression": "COUNTROWS('Latest Prices')",
            "formatString": "#,0"
          },
          {
            "name": "Latest Avg Price",
            "description": "Average of the latest reported prices",
            "expression": "AVERAGE('Latest Prices'[Latest Price])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Median Deviation %",
            "description": "Median deviation of market price from MSP in percent",
            "expression": "MEDIAN('Latest Prices'[Deviation %]) / 100",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Median Deviation from MSP",
            "description": "Median deviation of market price from MSP in rupees",
            "expression": "MEDIAN('Latest Prices'[Deviation from MSP])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Markets Above MSP",
            "description": "Markets trading above MSP",
            "expression": "CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Deviation from MSP] > 0)",
            "formatString": "#,0"
          },
          {
            "name": "Markets Below MSP",
            "description": "Markets trading below MSP",
            "expression": "CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Deviation from MSP] < 0)",
            "formatString": "#,0"
          },
          {
            "name": "% Above MSP",
            "description": "Share of markets trading above MSP",
            "expression": "DIVIDE([Markets Above MSP], [Markets Above MSP] + [Markets Below MSP])",
            "formatString": "0.0%;-0.0%"
          },
          {
            "name": "Rising Markets",
            "description": "Markets where price rose vs last week",
            "expression": "CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Trend] = \"up\")",
            "formatString": "#,0"
          },
          {
            "name": "Falling Markets",
            "description": "Markets where price fell vs last week",
            "expression": "CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Trend] = \"down\")",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "MSP Analysis",
        "columns": [
          {
            "name": "Commodity",
            "dataType": "string",
            "sourceColumn": "Commodity",
            "summarizeBy": "none"
          },
          {
            "name": "Avg Market Price",
            "dataType": "double",
            "sourceColumn": "'Avg Market Price'",
            "summarizeBy": "none"
          },
          {
            "name": "Average MSP",
            "dataType": "double",
            "sourceColumn": "'Average MSP'",
            "summarizeBy": "none"
          },
          {
            "name": "Records",
            "dataType": "int64",
            "sourceColumn": "Records",
            "summarizeBy": "sum"
          },
          {
            "name": "Price Difference",
            "dataType": "double",
            "sourceColumn": "'Price Difference'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "MSP Analysis",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"Commodity MSP Analysis.csv\"), [Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [cmdt_name] <> null and [cmdt_name] <> \"\"),",
                "    ReplacedNulls = Table.ReplaceValue(RemovedBlank, \"null\", null, Replacer.ReplaceValue, {\"average_msp\", \"price_difference\"}),",
                "    ReplacedCommodity = Table.ReplaceValue(ReplacedNulls, \"null\", \"Unknown\", Replacer.ReplaceValue, {\"cmdt_name\"}),",
                "    ChangedType = Table.TransformColumnTypes(ReplacedCommodity, {{\"cmdt_name\", type text}, {\"average_market_price\", type number}, {\"average_msp\", type number}, {\"total_records\", Int64.Type}, {\"price_difference\", type number}}),",
                "    RenamedColumns = Table.RenameColumns(ChangedType, {{\"cmdt_name\", \"Commodity\"}, {\"average_market_price\", \"Avg Market Price\"}, {\"average_msp\", \"Average MSP\"}, {\"total_records\", \"Records\"}, {\"price_difference\", \"Price Difference\"}})",
                "in",
                "    RenamedColumns"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Commodities Tracked",
            "description": "Number of commodities compared against MSP",
            "expression": "COUNTROWS('MSP Analysis')",
            "formatString": "#,0"
          },
          {
            "name": "Avg MSP",
            "description": "Average MSP across commodities",
            "expression": "AVERAGE('MSP Analysis'[Average MSP])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Avg Commodity Market Price",
            "description": "Average market price per commodity",
            "expression": "AVERAGE('MSP Analysis'[Avg Market Price])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Avg Price Gap vs MSP",
            "description": "Average gap between market price and MSP",
            "expression": "AVERAGE('MSP Analysis'[Price Difference])",
            "formatString": "₹ #,0"
          },
          {
            "name": "Commodities Above MSP",
            "description": "Commodities trading above MSP on average",
            "expression": "CALCULATE(COUNTROWS('MSP Analysis'), 'MSP Analysis'[Price Difference] > 0)",
            "formatString": "#,0"
          },
          {
            "name": "Commodities Below MSP",
            "description": "Commodities trading below MSP on average",
            "expression": "CALCULATE(COUNTROWS('MSP Analysis'), 'MSP Analysis'[Price Difference] < 0)",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Dim Commodity",
        "columns": [
          {
            "name": "Commodity",
            "dataType": "string",
            "sourceColumn": "Commodity",
            "summarizeBy": "none"
          },
          {
            "name": "Commodity Group",
            "dataType": "string",
            "sourceColumn": "'Commodity Group'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim Commodity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"Latest Market Prices.csv\"), [Delimiter=\",\", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [cmdt_name] <> null and [cmdt_name] <> \"\"),",
                "    ReplacedNulls = Table.ReplaceValue(RemovedBlank, \"null\", \"Unknown\", Replacer.ReplaceValue, {\"cmdt_name\"}),",
                "    SelectedColumns = Table.SelectColumns(ReplacedNulls, {\"cmdt_name\", \"cmdt_grp_name\"}),",
                "    RemovedDuplicates = Table.Distinct(SelectedColumns, {\"cmdt_name\"}),",
                "    ChangedType = Table.TransformColumnTypes(RemovedDuplicates, {{\"cmdt_name\", type text}, {\"cmdt_grp_name\", type text}}),",
                "    RenamedColumns = Table.RenameColumns(ChangedType, {{\"cmdt_name\", \"Commodity\"}, {\"cmdt_grp_name\", \"Commodity Group\"}})",
                "in",
                "    RenamedColumns"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim District",
        "columns": [
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State",
            "dataCategory": "State",
            "summarizeBy": "none"
          },
          {
            "name": "District",
            "dataType": "string",
            "sourceColumn": "District",
            "summarizeBy": "none"
          },
          {
            "name": "District Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'District Key'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim District",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"District Monthly Rainfall.csv\"), [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state] <> null and [state] <> \"\"),",
                "    SelectedColumns = Table.SelectColumns(RemovedBlank, {\"state\", \"district\"}),",
                "    RemovedDuplicates = Table.Distinct(SelectedColumns, {\"state\", \"district\"}),",
                "    ChangedType = Table.TransformColumnTypes(RemovedDuplicates, {{\"state\", type text}, {\"district\", type text}}),",
                "    AddedKey = Table.AddColumn(ChangedType, \"District Key\", each Text.Combine({Text.Lower([state]), \"|\", Text.Lower([district])}), type text),",
                "    RenamedColumns = Table.RenameColumns(AddedKey, {{\"state\", \"State\"}, {\"district\", \"District\"}})",
                "in",
                "    RenamedColumns"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Districts Monitored",
            "description": "Number of districts covered by rainfall monitoring",
            "expression": "DISTINCTCOUNT('Dim District'[District Key])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Daily Rainfall",
        "columns": [
          {
            "name": "State",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "State",
            "summarizeBy": "none"
          },
          {
            "name": "District",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "District",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "formatString": "dd MMM yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Actual Rainfall",
            "dataType": "double",
            "sourceColumn": "'Actual Rainfall'",
            "summarizeBy": "sum"
          },
          {
            "name": "Normal Rainfall",
            "dataType": "double",
            "sourceColumn": "'Normal Rainfall'",
            "summarizeBy": "sum"
          },
          {
            "name": "Departure %",
            "dataType": "double",
            "sourceColumn": "'Departure %'",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Category Name",
            "dataType": "string",
            "sourceColumn": "'Category Name'",
            "sortByColumn": "Category Order",
            "summarizeBy": "none"
          },
          {
            "name": "Category Order",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "'Category Order'",
            "summarizeBy": "none"
          },
          {
            "name": "District Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'District Key'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Daily Rainfall",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"Daily Rainfall Trend.csv\"), [Delimiter=\",\", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state] <> null and [state] <> \"\"),",
                "    ReplacedNulls = Table.ReplaceValue(RemovedBlank, \"null\", null, Replacer.ReplaceValue, {\"daily_departure_per\"}),",
                "    ChangedType = Table.TransformColumnTypes(ReplacedNulls, {{\"state\", type text}, {\"district\", type text}, {\"date\", type date}, {\"daily_actual\", type number}, {\"daily_normal\", type number}, {\"daily_departure_per\", type number}, {\"daily_category\", type text}}),",
                "    AddedCategoryName = Table.AddColumn(ChangedType, \"Category Name\", each if [daily_category] = \"LD\" then \"Large Deficit\" else if [daily_category] = \"D\" then \"Deficit\" else if [daily_category] = \"N\" then \"Normal\" else if [daily_category] = \"E\" then \"Excess\" else if [daily_category] = \"LE\" then \"Large Excess\" else if [daily_category] = \"NR\" then \"No Rain\" else \"Not Defined\", type text),",
                "    AddedCategoryOrder = Table.AddColumn(AddedCategoryName, \"Category Order\", each if [daily_category] = \"LD\" then 1 else if [daily_category] = \"D\" then 2 else if [daily_category] = \"N\" then 3 else if [daily_category] = \"E\" then 4 else if [daily_category] = \"LE\" then 5 else 6, Int64.Type),",
                "    AddedKey = Table.AddColumn(AddedCategoryOrder, \"District Key\", each Text.Combine({Text.Lower([state]), \"|\", Text.Lower([district])}), type text),",
                "    RenamedColumns = Table.RenameColumns(AddedKey, {{\"state\", \"State\"}, {\"district\", \"District\"}, {\"date\", \"Date\"}, {\"daily_actual\", \"Actual Rainfall\"}, {\"daily_normal\", \"Normal Rainfall\"}, {\"daily_departure_per\", \"Departure %\"}, {\"daily_category\", \"Category\"}})",
                "in",
                "    RenamedColumns"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Days Count",
            "description": "Number of district-day rainfall observations",
            "expression": "COUNTROWS('Daily Rainfall')",
            "formatString": "#,0"
          },
          {
            "name": "Total Actual Rainfall",
            "description": "Sum of actual daily rainfall (mm)",
            "expression": "SUM('Daily Rainfall'[Actual Rainfall])",
            "formatString": "#,0.0"
          },
          {
            "name": "Total Normal Rainfall",
            "description": "Sum of normal daily rainfall (mm)",
            "expression": "SUM('Daily Rainfall'[Normal Rainfall])",
            "formatString": "#,0.0"
          },
          {
            "name": "Rainfall Departure %",
            "description": "Overall rainfall departure from normal",
            "expression": "DIVIDE([Total Actual Rainfall] - [Total Normal Rainfall], [Total Normal Rainfall])",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Deficit Days",
            "description": "District-days in deficit or large deficit",
            "expression": "CALCULATE(COUNTROWS('Daily Rainfall'), 'Daily Rainfall'[Category] IN { \"LD\", \"D\" })",
            "formatString": "#,0"
          },
          {
            "name": "Excess Days",
            "description": "District-days in excess or large excess",
            "expression": "CALCULATE(COUNTROWS('Daily Rainfall'), 'Daily Rainfall'[Category] IN { \"LE\", \"E\" })",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Monthly Rainfall",
        "columns": [
          {
            "name": "State",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "State",
            "summarizeBy": "none"
          },
          {
            "name": "District",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "District",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Month Start",
            "dataType": "dateTime",
            "isHidden": true,
            "sourceColumn": "'Month Start'",
            "formatString": "dd MMM yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "sourceColumn": "'Month Name'",
            "sortByColumn": "Month Start",
            "summarizeBy": "none"
          },
          {
            "name": "Records",
            "dataType": "int64",
            "sourceColumn": "Records",
            "summarizeBy": "sum"
          },
          {
            "name": "Total Rainfall",
            "dataType": "double",
            "sourceColumn": "'Total Rainfall'",
            "summarizeBy": "sum"
          },
          {
            "name": "Avg Daily Rainfall",
            "dataType": "double",
            "sourceColumn": "'Avg Daily Rainfall'",
            "summarizeBy": "none"
          },
          {
            "name": "Avg Normal Daily Rainfall",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Avg Normal Daily Rainfall'",
            "summarizeBy": "none"
          },
          {
            "name": "Normal Total",
            "dataType": "double",
            "isHidden": true,
            "sourceColumn": "'Normal Total'",
            "summarizeBy": "sum"
          },
          {
            "name": "District Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "'District Key'",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Monthly Rainfall",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"/\" & \"District Monthly Rainfall.csv\"), [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state] <> null and [state] <> \"\"),",
                "    ChangedType = Table.TransformColumnTypes(RemovedBlank, {{\"state\", type text}, {\"district\", type text}, {\"year\", Int64.Type}, {\"month\", Int64.Type}, {\"total_records\", Int64.Type}, {\"total_rainfall\", type number}, {\"average_rainfall\", type number}, {\"average_normal_rainfall\", type number}}),",
                "    AddedMonthStart = Table.AddColumn(ChangedType, \"Month Start\", each #date([year], [month], 1), type date),",
                "    AddedMonthName = Table.AddColumn(AddedMonthStart, \"Month Name\", each Date.MonthName([Month Start], \"en-US\"), type text),",
                "    AddedNormalTotal = Table.AddColumn(AddedMonthName, \"Normal Total\", each [average_normal_rainfall] * [total_records], type number),",
                "    AddedKey = Table.AddColumn(AddedNormalTotal, \"District Key\", each Text.Combine({Text.Lower([state]), \"|\", Text.Lower([district])}), type text),",
                "    RenamedColumns = Table.RenameColumns(AddedKey, {{\"state\", \"State\"}, {\"district\", \"District\"}, {\"year\", \"Year\"}, {\"month\", \"Month\"}, {\"total_records\", \"Records\"}, {\"total_rainfall\", \"Total Rainfall\"}, {\"average_rainfall\", \"Avg Daily Rainfall\"}, {\"average_normal_rainfall\", \"Avg Normal Daily Rainfall\"}})",
                "in",
                "    RenamedColumns"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Monthly Rainfall Total",
            "description": "Total monthly rainfall across districts (mm)",
            "expression": "SUM('Monthly Rainfall'[Total Rainfall])",
            "formatString": "#,0.0"
          },
          {
            "name": "Monthly Normal Total",
            "description": "Total normal monthly rainfall across districts (mm)",
            "expression": "SUM('Monthly Rainfall'[Normal Total])",
            "formatString": "#,0.0"
          },
          {
            "name": "Monthly Departure %",
            "description": "Monthly rainfall departure from normal",
            "expression": "DIVIDE([Monthly Rainfall Total] - [Monthly Normal Total], [Monthly Normal Total])",
            "formatString": "+0.0%;-0.0%;0.0%"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Market Prices to Dim Commodity",
