table '_SVG Measures'

	/// SVG page header: MANDI MARKET INTELLIGENCE
	measure P1_Header = ```
		VAR _Title = "MANDI MARKET INTELLIGENCE"
		VAR _Sub = "Overview - prices, markets and commodity coverage"
		VAR _Bg = "%231B2A38"
		VAR _Accent = "%23FDBF11"
		VAR _White = "%23FFFFFF"
		VAR _Muted = "%23A9B6C2"
		RETURN
		    "data:image/svg+xml;charset=utf-8,"
		        & "<svg width='100%%25' height='100%%25' viewBox='0 0 1280 64' overflow='visible' display='block' xmlns='http://www.w3.org/2000/svg'>"
		        & "<rect x='0' y='0' width='1280' height='64' fill='" & _Bg & "'/>"
		        & "<rect x='0' y='60' width='240' height='4' fill='" & _Accent & "'/>"
		        & "<text x='24' y='40' font-family='Segoe UI Semibold' font-size='20' letter-spacing='0.5' fill='" & _White & "'>" & _Title & "</text>"
		        & "<text x='1256' y='40' text-anchor='end' font-family='Segoe UI' font-size='12' fill='" & _Muted & "'>" & _Sub & "</text>"
		        & "</svg>"
		```
		dataCategory: ImageUrl
		formatString: General

	/// SVG page header: PRICE VS MSP ANALYSIS
	measure P2_Header = ```
