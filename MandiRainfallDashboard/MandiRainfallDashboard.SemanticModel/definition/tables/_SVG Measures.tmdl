	/// SVG KPI card: States Covered
	measure P1_States_KPI = ```
		VAR _Title = "STATES COVERED"
		VAR _Value = SUBSTITUTE(FORMAT([States Count], "#,0"), "%", "%25")
		VAR _Sub = "States with reporting mandis"
		VAR _Bg = "%231B2A38"
		VAR _Accent = "%23FDBF11"
		VAR _Muted = "%23A9B6C2"
		VAR _White = "%23FFFFFF"
		RETURN
		    "data:image/svg+xml;charset=utf-8,"
		        & "<svg width='100%25' height='100%25' viewBox='0 0 236 110' overflow='visible' display='block' xmlns='http://www.w3.org/2000/svg'>"
		        & "<rect x='0' y='0' width='236' height='110' rx='10' fill='" & _Bg & "'/>"
		        & "<rect x='0' y='8' width='5' height='94' fill='" & _Accent & "'/>"
		        & "<text x='20' y='32' font-family='Segoe UI' font-size='11' letter-spacing='1.2' fill='" & _Muted & "'>" & _Title & "</text>"
		        & "<text x='20' y='70' font-family='Segoe UI Semibold' font-size='27' fill='" & _White & "'>" & _Value & "</text>"
		        & "<text x='20' y='92' font-family='Segoe UI' font-size='10' fill='" & _Muted & "'>" & _Sub & "</text>"
		        & "</svg>"
		```
		dataCategory: ImageUrl
		formatString: General

