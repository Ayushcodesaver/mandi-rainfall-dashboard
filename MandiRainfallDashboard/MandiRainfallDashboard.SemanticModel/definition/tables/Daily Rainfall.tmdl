table 'Daily Rainfall'

	/// Number of district-day rainfall observations
	measure 'Days Count' = COUNTROWS('Daily Rainfall')
		formatString: #,0

	/// Sum of actual daily rainfall (mm)
	measure 'Total Actual Rainfall' = SUM('Daily Rainfall'[Actual Rainfall])
		formatString: #,0.0

	/// Sum of normal daily rainfall (mm)
	measure 'Total Normal Rainfall' = SUM('Daily Rainfall'[Normal Rainfall])
		formatString: #,0.0

	/// Overall rainfall departure from normal
	measure 'Rainfall Departure %' = DIVIDE([Total Actual Rainfall] - [Total Normal Rainfall], [Total Normal Rainfall])
		formatString: +0.0%;-0.0%;0.0%

	/// District-days in deficit or large deficit
	measure 'Deficit Days' = CALCULATE(COUNTROWS('Daily Rainfall'), 'Daily Rainfall'[Category] IN { "LD", "D" })
		formatString: #,0

	/// District-days in excess or large excess
	measure 'Excess Days' = CALCULATE(COUNTROWS('Daily Rainfall'), 'Daily Rainfall'[Category] IN { "LE", "E" })
		formatString: #,0

	column State
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: State

	column District
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: District

	column Date
		dataType: dateTime
		formatString: dd MMM yyyy
		summarizeBy: none
		sourceColumn: Date

	column 'Actual Rainfall'
		dataType: double
		summarizeBy: sum
		sourceColumn: 'Actual Rainfall'

	column 'Normal Rainfall'
		dataType: double
		summarizeBy: sum
		sourceColumn: 'Normal Rainfall'

	column 'Departure %'
		dataType: double
		summarizeBy: none
		sourceColumn: 'Departure %'

	column Category
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Category

	column 'Category Name'
		dataType: string
		sortByColumn: 'Category Order'
		summarizeBy: none
		sourceColumn: 'Category Name'

	column 'Category Order'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: 'Category Order'

	column 'District Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: 'District Key'

	partition 'Daily Rainfall' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(SourceFolder & "/" & "Daily Rainfall Trend.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state] <> null and [state] <> ""),
			    ReplacedNulls = Table.ReplaceValue(RemovedBlank, "null", null, Replacer.ReplaceValue, {"daily_departure_per"}),
			    ChangedType = Table.TransformColumnTypes(ReplacedNulls, {{"state", type text}, {"district", type text}, {"date", type date}, {"daily_actual", type number}, {"daily_normal", type number}, {"daily_departure_per", type number}, {"daily_category", type text}}),
			    AddedCategoryName = Table.AddColumn(ChangedType, "Category Name", each if [daily_category] = "LD" then "Large Deficit" else if [daily_category] = "D" then "Deficit" else if [daily_category] = "N" then "Normal" else if [daily_category] = "E" then "Excess" else if [daily_category] = "LE" then "Large Excess" else if [daily_category] = "NR" then "No Rain" else "Not Defined", type text),
			    AddedCategoryOrder = Table.AddColumn(AddedCategoryName, "Category Order", each if [daily_category] = "LD" then 1 else if [daily_category] = "D" then 2 else if [daily_category] = "N" then 3 else if [daily_category] = "E" then 4 else if [daily_category] = "LE" then 5 else 6, Int64.Type),
			    AddedKey = Table.AddColumn(AddedCategoryOrder, "District Key", each Text.Combine({Text.Lower([state]), "|", Text.Lower([district])}), type text),
			    RenamedColumns = Table.RenameColumns(AddedKey, {{"state", "State"}, {"district", "District"}, {"date", "Date"}, {"daily_actual", "Actual Rainfall"}, {"daily_normal", "Normal Rainfall"}, {"daily_departure_per", "Departure %"}, {"daily_category", "Category"}})
			in
			    RenamedColumns
