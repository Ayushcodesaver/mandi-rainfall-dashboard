table 'Latest Prices'

	/// Number of market-commodity price rows reported
	measure 'Markets Reporting' = COUNTROWS('Latest Prices')
		formatString: #,0

	/// Average of the latest reported prices
	measure 'Latest Avg Price' = AVERAGE('Latest Prices'[Latest Price])
		formatString: ₹ #,0

	/// Median deviation of market price from MSP in percent
	measure 'Median Deviation %' = MEDIAN('Latest Prices'[Deviation %]) / 100
		formatString: +0.0%;-0.0%;0.0%

	/// Median deviation of market price from MSP in rupees
	measure 'Median Deviation from MSP' = MEDIAN('Latest Prices'[Deviation from MSP])
		formatString: ₹ #,0

	/// Markets trading above MSP
	measure 'Markets Above MSP' = CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Deviation from MSP] > 0)
		formatString: #,0

	/// Markets trading below MSP
	measure 'Markets Below MSP' = CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Deviation from MSP] < 0)
		formatString: #,0

	/// Share of markets trading above MSP
	measure '% Above MSP' = DIVIDE([Markets Above MSP], [Markets Above MSP] + [Markets Below MSP])
		formatString: 0.0%;-0.0%

	/// Markets where price rose vs last week
	measure 'Rising Markets' = CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Trend] = "up")
		formatString: #,0

	/// Markets where price fell vs last week
	measure 'Falling Markets' = CALCULATE(COUNTROWS('Latest Prices'), 'Latest Prices'[Trend] = "down")
		formatString: #,0

	column State
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: State

	column District
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: District

	column Market
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Market

	column Commodity
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Commodity

	column 'Commodity Group'
		dataType: string
		summarizeBy: none
		sourceColumn: 'Commodity Group'

	column 'Latest Price'
		dataType: double
		summarizeBy: none
		sourceColumn: 'Latest Price'

	column Trend
		dataType: string
		summarizeBy: none
		sourceColumn: Trend

	column 'Cumulative Arrivals'
		dataType: double
		summarizeBy: sum
		sourceColumn: 'Cumulative Arrivals'

	column 'MSP Price'
		dataType: double
		summarizeBy: none
		sourceColumn: 'MSP Price'

	column 'Price 5 Days Ago'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: 'Price 5 Days Ago'

	column 'Price 1 Week Ago'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: 'Price 1 Week Ago'

	column 'Price 1 Month Ago'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: 'Price 1 Month Ago'

	column 'Price 1 Year Ago'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: 'Price 1 Year Ago'

	column 'Price 2 Years Ago'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: 'Price 2 Years Ago'

	column 'Price 3 Years Ago'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: 'Price 3 Years Ago'

	column 'Reported Date'
		dataType: dateTime
		formatString: dd MMM yyyy
		summarizeBy: none
		sourceColumn: 'Reported Date'

	column 'Deviation %'
		dataType: double
		summarizeBy: none
		sourceColumn: 'Deviation %'

	column 'Deviation from MSP'
		dataType: double
		summarizeBy: none
		sourceColumn: 'Deviation from MSP'

	column 'Commodity Missing'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: 'Commodity Missing'

	column Source
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Source

	column 'Loaded At'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: 'Loaded At'

	column 'Price Key'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: 'Price Key'

	partition 'Latest Prices' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(SourceFolder & "/" & "Latest Market Prices.csv"), [Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    RemovedBlank = Table.SelectRows(PromotedHeaders, each [state_name] <> null and [state_name] <> ""),
			    ReplacedNulls = Table.ReplaceValue(RemovedBlank, "null", null, Replacer.ReplaceValue, {"one_yr_ago", "two_yr_ago", "three_yr_ago", "one_week_ago", "one_month_ago", "msp_price", "deviation_percent", "deviation_from_msp", "commodity_missing"}),
			    ReplacedText = Table.ReplaceValue(ReplacedNulls, "null", "Unknown", Replacer.ReplaceValue, {"trend", "cmdt_name"}),
			    ChangedType = Table.TransformColumnTypes(ReplacedText, {{"as_on", type number}, {"state_name", type text}, {"trend", type text}, {"cumm_arr", type number}, {"cmdt_name", type text}, {"msp_price", type number}, {"one_yr_ago", type number}, {"two_yr_ago", type number}, {"market_name", type text}, {"one_week_ago", type number}, {"three_yr_ago", type number}, {"cmdt_grp_name", type text}, {"district_name", type text}, {"last_five_day", type number}, {"one_month_ago", type number}, {"reported_date", type date}, {"deviation_percent", type number}, {"deviation_from_msp", type number}, {"commodity_missing", type text}, {"bronze_source", type text}, {"bronze_loaded_at", type text}}),
			    RenamedColumns = Table.RenameColumns(ChangedType, {{"as_on", "Latest Price"}, {"trend", "Trend"}, {"cumm_arr", "Cumulative Arrivals"}, {"cmdt_name", "Commodity"}, {"msp_price", "MSP Price"}, {"one_yr_ago", "Price 1 Year Ago"}, {"state_name", "State"}, {"two_yr_ago", "Price 2 Years Ago"}, {"market_name", "Market"}, {"one_week_ago", "Price 1 Week Ago"}, {"three_yr_ago", "Price 3 Years Ago"}, {"cmdt_grp_name", "Commodity Group"}, {"district_name", "District"}, {"last_five_day", "Price 5 Days Ago"}, {"one_month_ago", "Price 1 Month Ago"}, {"reported_date", "Reported Date"}, {"deviation_percent", "Deviation %"}, {"deviation_from_msp", "Deviation from MSP"}, {"commodity_missing", "Commodity Missing"}, {"bronze_source", "Source"}, {"bronze_loaded_at", "Loaded At"}}),
			    AddedKey = Table.AddColumn(RenamedColumns, "Price Key", each Text.Combine({Text.Lower([State]), "|", Text.Lower([District]), "|", Text.Lower([Market]), "|", Text.Lower([Commodity])}), type text)
			in
			    AddedKey
